# TrustLayer Frontend — required environment variables.
# Copy this file to .env.local and fill in the values for your environment.
#
# NEXT_PUBLIC_BACKEND_URL  — Base URL of the TrustLayer backend API.
#   Must be a valid http/https URL. Production environments must NOT use
#   localhost, 127.0.0.1, .test, .local, or other dev-looking hosts.
#
# NEXT_PUBLIC_APP_ENV      — One of: development, test, production.
#   Controls environment identity diagnostics and endpoint mixing checks.

# Development (local backend)
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_APP_ENV=development

# Test
# NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
# NEXT_PUBLIC_APP_ENV=test

# Production
# NEXT_PUBLIC_BACKEND_URL=https://api.trustlayer.io
# NEXT_PUBLIC_APP_ENV=production
